BACKEND_API_URL=http://localhost:8080

# Exact browser origins for order actions and product-image cleanup (no trailing slash).
# Add your public ngrok origin separated by a comma, then restart Next.js.
# If unset, only request.nextUrl.origin is allowed; an empty value denies all origins.
ALLOWED_REQUEST_ORIGINS=http://localhost:3000

# UploadThing dashboard > API Keys > V7 token. Keep this server-side.
# Set the UploadThing app's default ACL to public-read for seller documents.
UPLOADTHING_TOKEN=
