BACKEND_API_URL=http://localhost:8080

# Demo only. Enable both flags here AND MOCK_PAYMENT_ENABLED in backend/.env.
# Restart Next.js after changing these. Keep all flags false in production.
NEXT_PUBLIC_MOCK_PAYMENT=false
MOCK_PAYMENT_ENABLED=false

# UploadThing dashboard > API Keys > V7 token. Keep this server-side.
# Set the UploadThing app's default ACL to public-read for seller documents.
UPLOADTHING_TOKEN=
