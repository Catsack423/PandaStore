{
  "info": {
    "_postman_id": "pandastore-2_Order_Orchestration.postman_collection.json",
    "name": "2. Order Orchestration (OrderOrchestrationController -> OrderOrchestrationServiceImp)",
    "description": "Order Group creation from cart checkout, payment method selection, order group details, and negative validation tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "orderGroupId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "2.1 (TC06) Create Order Group From Cart",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created or 200 OK\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "pm.test(\"Capture Order Group ID\", function () {",
              "    const json = pm.response.json();",
              "    if (json.data) {",
              "        pm.collectionVariables.set(\"orderGroupId\", json.data);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/order-groups",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "order-groups"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": 1,\n  \"shippingAddressId\": 1,\n  \"sellerShippingMethods\": {\n    \"1\": \"FLASH\"\n  },\n  \"paymentMethod\": \"PROMPTPAY\"\n}"
        }
      }
    },
    {
      "name": "2.2 (TC07) Get Order Group Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Verify Order Group Details\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/order-groups/{{orderGroupId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "order-groups",
            "{{orderGroupId}}"
          ]
        }
      }
    },
    {
      "name": "2.3 (TC08) Create Order Group - Empty Body / Validation Error (Negative Test)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Validation errors returned\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.eql(false);",
              "    pm.expect(json.error).to.be.an(\"object\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/order-groups",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "order-groups"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      }
    }
  ]
}