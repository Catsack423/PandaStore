{
  "info": {
    "_postman_id": "pandastore-4_Shipping_Logistics.postman_collection.json",
    "name": "4. PandaStore - Shipping Logistics",
    "description": "Shipping fee calculation, tracking number assignment (random courier and tracking code), shipment status tracking and delivery updates.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "sellerId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "3",
      "type": "string"
    },
    {
      "key": "orderId_shipped",
      "value": "4",
      "type": "string"
    },
    {
      "key": "shipmentId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "4.1 (TC15) Calculate Shipping Fee (Random Method)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const methods = [\"FLASH\", \"KERRY\", \"EMS\", \"STANDARD\"];",
              "const chosenMethod = methods[Math.floor(Math.random() * methods.length)];",
              "pm.collectionVariables.set(\"temp_shipping_method\", chosenMethod);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Shipping fee calculated successfully\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.eql(true);",
              "    pm.expect(json.data.shippingFee).to.be.at.least(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/shipping/calculate-fee",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shipping",
            "calculate-fee"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sellerId\": 1,\n  \"shippingMethod\": \"{{temp_shipping_method}}\",\n  \"addressId\": 1\n}"
        }
      }
    },
    {
      "name": "4.2 (TC16) Assign Tracking Number (Random Tracking & Courier)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const couriers = [\"Flash Express\", \"Kerry Express\", \"Thailand Post (EMS)\", \"J&T Express\"];",
              "const randomCourier = couriers[Math.floor(Math.random() * couriers.length)];",
              "const randomDigits = Math.floor(Math.random() * 9000000000) + 1000000000;",
              "const tracking = \"TH\" + randomDigits;",
              "pm.collectionVariables.set(\"temp_courier_name\", randomCourier);",
              "pm.collectionVariables.set(\"temp_tracking_number\", tracking);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Shipment created and tracking assigned\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.eql(true);",
              "    if (json.data && json.data.shipmentId) {",
              "        pm.collectionVariables.set(\"shipmentId\", json.data.shipmentId);",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/shipping/orders/{{orderId}}/assign-tracking?sellerId={{sellerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shipping",
            "orders",
            "{{orderId}}",
            "assign-tracking"
          ],
          "query": [
            {
              "key": "sellerId",
              "value": "{{sellerId}}"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"courierName\": \"{{temp_courier_name}}\",\n  \"trackingNumber\": \"{{temp_tracking_number}}\"\n}"
        }
      }
    },
    {
      "name": "4.3 (TC17) Get Shipment By Order ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Shipment info has trackingNumber\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/shipping/orders/{{orderId_shipped}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shipping",
            "orders",
            "{{orderId_shipped}}"
          ]
        }
      }
    },
    {
      "name": "4.4 (TC18) Update Shipping Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/shipping/shipments/{{shipmentId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "shipping",
            "shipments",
            "{{shipmentId}}",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"DELIVERED\"\n}"
        }
      }
    }
  ]
}