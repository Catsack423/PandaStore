<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Approved exception: Spring constructor injection and mutable JPA/DTO
         relationships retain framework-managed references. Only these two
         representation warnings are excluded; all other rules remain enabled. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>
    <!-- Approved exception for this exact class only: the stateless backend
         authenticates solely from the Authorization Bearer header.
         JwtAuthenticationFilter does not read cookies. Next.js checks Origin
         on browser cookie-authenticated mutations. SecurityGateTest also
         verifies that a valid JWT supplied only in a cookie cannot authenticate. -->
    <Match>
        <Class name="project.project.Config.SecurityConfig" />
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED" />
    </Match>
</FindBugsFilter>
