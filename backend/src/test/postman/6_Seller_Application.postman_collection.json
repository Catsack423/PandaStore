      "name": "6.1 (TC25) Submit Seller Application (Valid Submission - Status PENDING)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const randomNum = Math.floor(Math.random() * 90000000000) + 10000000000;",
              "const idCard = `1${randomNum.toString().padStart(12, '0').slice(0, 12)}`;",
              "const shopSuffix = Math.floor(Math.random() * 900) + 100;",
              "const shopName = `Panda Craft Studio #${shopSuffix}`;",
              "const phone = `08${Math.floor(Math.random() * 90000000) + 10000000}`;",
              "const email = `craft${shopSuffix}@pandastore.com`;",
              "pm.collectionVariables.set(\"temp_shop_name\", shopName);",
              "pm.collectionVariables.set(\"temp_shop_phone\", phone);",
              "pm.collectionVariables.set(\"temp_shop_email\", email);",
              "pm.collectionVariables.set(\"temp_id_card\", idCard);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response has success true\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.eql(true);",
              "    pm.expect(json.data).to.have.property(\"applicationId\");",
              "    pm.expect(json.data.status).to.eql(\"PENDING\");",
              "    pm.collectionVariables.set(\"applicationId\", json.data.applicationId);",
              "});"
            ]
          }
        }
      ],
