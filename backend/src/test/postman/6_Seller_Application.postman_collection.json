    {
      "name": "6.0 (TC24B) Register New Seller User Directly",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const timestamp = Date.now();",
              "const randomNum = Math.floor(Math.random() * 90000000000) + 10000000000;",
              "const idCard = `3${randomNum.toString().padStart(12, '0').slice(0, 12)}`;",
              "const username = `seller_${timestamp.toString().slice(-6)}`;",
              "const email = `${username}@pandastore.com`;",
              "const shopName = `Panda Official #${Math.floor(Math.random() * 9000) + 1000}`;",
              "const phone = `08${Math.floor(Math.random() * 90000000) + 10000000}`;",
              "const bankAccount = `${Math.floor(Math.random() * 9000000000) + 1000000000}`;",
              "pm.collectionVariables.set(\"temp_reg_username\", username);",
              "pm.collectionVariables.set(\"temp_reg_email\", email);",
              "pm.collectionVariables.set(\"temp_reg_shop\", shopName);",
              "pm.collectionVariables.set(\"temp_reg_phone\", phone);",
              "pm.collectionVariables.set(\"temp_reg_idcard\", idCard);",
              "pm.collectionVariables.set(\"temp_reg_bankacc\", bankAccount);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response has success true and sellerId\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.eql(true);",
              "    pm.expect(json.data).to.have.property(\"sellerId\");",
              "    pm.collectionVariables.set(\"createdSellerId\", json.data.sellerId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register/seller",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register",
            "seller"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{temp_reg_username}}\",\n  \"email\": \"{{temp_reg_email}}\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\",\n  \"shopName\": \"{{temp_reg_shop}}\",\n  \"shopDescription\": \"ร้านค้าตัวแทนจำหน่ายอย่างเป็นทางการ PandaStore\",\n  \"shopPhone\": \"{{temp_reg_phone}}\",\n  \"shopEmail\": \"{{temp_reg_email}}\",\n  \"shopAddress\": \"99/9 ถ.มิตรภาพ ต.ในเมือง อ.เมือง จ.ขอนแก่น 40000\",\n  \"sellerFirstName\": \"สมพงษ์\",\n  \"sellerLastName\": \"เจริญรุ่งเรือง\",\n  \"idCardNumber\": \"{{temp_reg_idcard}}\",\n  \"bankName\": \"ธนาคารกสิกรไทย\",\n  \"bankAccountName\": \"นายสมพงษ์ เจริญรุ่งเรือง\",\n  \"bankAccountNumber\": \"{{temp_reg_bankacc}}\",\n  \"idCardImageUrl\": \"https://images.unsplash.com/photo-1544717305-2782549b5136\",\n  \"bankBookImageUrl\": \"https://images.unsplash.com/photo-1554224155-6726b3ff858f\",\n  \"proofImageUrl\": \"https://images.unsplash.com/photo-1554224155-6726b3ff858f\"\n}"
        }
