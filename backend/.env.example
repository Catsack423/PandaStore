# Supabase: copy the host from Dashboard > Connect. Keep passwords out of this URL.
# Direct (requires IPv6 unless the project has the IPv4 add-on):
# DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Session pooler (IPv4, suitable for a persistent Spring Boot backend):
# DB_URL=jdbc:postgresql://YOUR_POOLER_HOST:5432/postgres?sslmode=require
# DB_USERNAME=postgres.YOUR_PROJECT_REF
# Transaction pooler uses port 6543 and also needs &prepareThreshold=0 in DB_URL.
DB_URL=
DB_USERNAME=postgres
DB_PASSWORD=

# Connection budget per backend instance; keep the total within the project limits.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_SHOW_SQL=false
# Use validate for deployment after the existing schema has been prepared.
# update retains the existing local schema setup behavior; never use create/create-drop on Supabase.
DB_DDL_AUTO=update
PORT=8080

# Exact frontend origins separated by commas. Never use *.
ALLOWED_REQUEST_ORIGINS=http://localhost:3000
# Optional NVD API key for Dependency Check (shell environment, not Spring config).
NVD_API_KEY=
# Demo accounts are disabled by default. Enable only with an isolated local database.
SEED_DATA=false

# Generate yourself: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required: exactly 64 hex characters. Never commit your real key.
JWT_SECRET=
