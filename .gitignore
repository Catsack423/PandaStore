# ==========================================
# PandaStore Project .gitignore
# ==========================================

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------
# IDEs and Editors
# ------------------------------------------
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Visual Studio Code
.vscode/
*.code-workspace
.history/

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/
.nb-gradle/

# General editor backups
*.swp
*.swo
*~
*.bak

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ------------------------------------------
# Backend (Java / Spring Boot / Maven)
# ------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Logs
*.log
logs/
**/logs/

# H2 / Embedded DB files
*.mv.db
*.trace.db

# ------------------------------------------
# Frontend (Node.js / React / Vue / Angular)
# ------------------------------------------
node_modules/
**/node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Frontend Build Output
frontend/dist/
frontend/build/
**/dist/
**/build/
.next/
.nuxt/

# ------------------------------------------
# Misc & Temporary Files
# ------------------------------------------
tmp/
temp/
.cache/
PROGRESS_TRACKING.md

