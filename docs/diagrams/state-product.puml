' Sources: backend/src/main/java/project/project/Service/implement/ProductServiceImp.java; InventoryServiceImp.java; SubOrderServiceImp.java
' Sources: backend/src/main/java/project/project/Repository/ProductRepository.java; Controller/ProductController.java
@enduml
