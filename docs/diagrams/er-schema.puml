@startuml er-schema
!include _style.puml
title PandaStore - PostgreSQL Schema (21 Tables)
top to bottom direction
hide circle
skinparam linetype ortho

package "Identity and seller onboarding" {
  entity "users" as users {
    * created_at : timestamp(6)
      updated_at : timestamp(6)
    * user_id : bigint <<PK, identity>>
    * role : varchar(20)
    * status : varchar(20)
    * username : varchar(50) <<UQ>>
    * email : varchar(100) <<UQ>>
    * password_hash : varchar(255)
  }
  entity "auth_sessions" as auth_sessions {
    * expires_at : timestamp(6) with time zone
    * user_id : bigint <<FK>>
    * token_hash : varchar(64) <<PK>>
    * credential_hash : varchar(255)
  }
  entity "customers" as customers {
    * customer_id : bigint <<PK, identity>>
    * user_id : bigint <<FK, UQ>>
      phone_number : varchar(20)
      full_name : varchar(100)
  }
  entity "addresses" as addresses {
    * is_default : boolean
    * address_id : bigint <<PK, identity>>
    * customer_id : bigint <<FK>>
    * postal_code : varchar(10)
    * phone_number : varchar(20)
    * district : varchar(100)
    * province : varchar(100)
    * receiver_name : varchar(100)
    * address_line : varchar(255)
  }
  entity "sellers" as sellers {
      rating : numeric(3,2)
    * created_at : timestamp(6)
    * seller_id : bigint <<PK, identity>>
    * user_id : bigint <<FK, UQ>>
    * shop_phone : varchar(20)
    * status : varchar(20)
    * shop_email : varchar(100)
    * shop_name : varchar(100) <<UQ>>
    * shop_address : varchar(255)
      shop_description : TEXT
  }
  entity "seller_applications" as seller_applications {
    * application_id : bigint <<PK, identity>>
    * created_at : timestamp(6)
      reviewed_at : timestamp(6)
      reviewed_by : bigint <<FK>>
    * user_id : bigint <<FK>>
    * id_card_number : varchar(13)
    * shop_phone : varchar(20)
    * status : varchar(20)
    * bank_account_number : varchar(30)
    * bank_account_name : varchar(100)
    * bank_name : varchar(100)
    * seller_first_name : varchar(100)
    * seller_last_name : varchar(100)
    * shop_email : varchar(100)
    * shop_name : varchar(100)
      admin_note : TEXT
    * bank_book_image_url : varchar(255)
    * id_card_image_url : varchar(255)
    * shop_address : varchar(255)
    * shop_description : TEXT
  }
  entity "seller_bank_accounts" as seller_bank_accounts {
    * bank_account_id : bigint <<PK, identity>>
    * seller_id : bigint <<FK>>
    * account_number : varchar(30)
    * account_name : varchar(100)
    * bank_name : varchar(100)
    * proof_image_url : varchar(255)
  }
}

package "Product catalog" {
  entity "products" as products {
      average_rating : numeric(3,2)
    * price : numeric(12,2)
    * review_count : integer
    * stock : integer
    * created_at : timestamp(6)
    * product_id : bigint <<PK, identity>>
    * seller_id : bigint <<FK>>
      updated_at : timestamp(6)
    * status : varchar(20)
    * name : varchar(200)
      description : TEXT
      shipping_info : varchar(255)
  }
  entity "categories" as categories {
    * category_id : bigint <<PK, identity>>
    * category_name : varchar(100)
      description : varchar(255)
  }
  entity "product_categories" as product_categories {
    * category_id : bigint <<PK, FK>>
    * product_id : bigint <<PK, FK>>
  }
  entity "product_images" as product_images {
    * display_order : integer
    * is_primary : boolean
    * image_id : bigint <<PK, identity>>
    * product_id : bigint <<FK>>
    * image_url : varchar(255)
  }
}

package "Cart, checkout and fulfillment" {
  entity "carts" as carts {
    * cart_id : bigint <<PK, identity>>
    * customer_id : bigint <<FK, UQ>>
  }
  entity "cart_items" as cart_items {
    * is_selected : boolean
    * quantity : integer
    * cart_id : bigint <<FK>>
    * cart_item_id : bigint <<PK, identity>>
    * product_id : bigint <<FK>>
  }
  entity "order_groups" as order_groups {
    * grand_total : numeric(12,2)
      total_discount : numeric(12,2)
    * total_products_amount : numeric(12,2)
    * total_shipping_fee : numeric(12,2)
    * created_at : timestamp(6)
    * customer_id : bigint <<FK>>
    * order_group_id : bigint <<PK, identity>>
    * shipping_address_id : bigint <<FK>>
    * payment_status : varchar(25)
    * group_number : varchar(36) <<UQ>>
  }
  entity "orders" as orders {
      seller_discount : numeric(12,2)
    * shipping_fee : numeric(12,2)
    * subtotal : numeric(12,2)
    * total_amount : numeric(12,2)
      completed_at : timestamp(6)
    * created_at : timestamp(6)
    * order_group_id : bigint <<FK>>
    * order_id : bigint <<PK, identity>>
    * seller_id : bigint <<FK>>
      shipped_at : timestamp(6)
    * order_status : varchar(30)
    * sub_order_number : varchar(36) <<UQ>>
      shipping_method : varchar(100)
      rejection_reason : varchar(255)
  }
  entity "order_items" as order_items {
    * is_reviewed : boolean
    * quantity : integer
    * total_price : numeric(12,2)
    * unit_price : numeric(12,2)
    * order_id : bigint <<FK>>
    * order_item_id : bigint <<PK, identity>>
    * product_id : bigint <<FK>>
    * product_name : varchar(200)
  }
  entity "payments" as payments {
    * amount : numeric(12,2)
      refunded_amount : numeric(12,2)
    * order_group_id : bigint <<FK, UQ>>
      paid_at : timestamp(6)
    * payment_id : bigint <<PK, identity>>
    * status : varchar(25)
    * payment_method : varchar(30)
      gateway_transaction_id : varchar(100)
  }
  entity "shipments" as shipments {
      delivered_at : timestamp(6)
    * order_id : bigint <<FK, UQ>>
    * shipment_id : bigint <<PK, identity>>
      shipped_at : timestamp(6)
    * shipping_status : varchar(25)
    * courier_name : varchar(100)
    * tracking_number : varchar(100)
  }
}

package "Feedback and notifications" {
  entity "reviews" as reviews {
    * is_auto_review : boolean
    * rating : integer
    * created_at : timestamp(6)
    * customer_id : bigint <<FK>>
    * order_item_id : bigint <<FK, UQ>>
    * product_id : bigint <<FK>>
    * review_id : bigint <<PK, identity>>
      updated_at : timestamp(6)
      comment : TEXT
  }
  entity "review_replies" as review_replies {
    * replied_at : timestamp(6)
    * reply_id : bigint <<PK, identity>>
    * review_id : bigint <<FK, UQ>>
    * seller_id : bigint <<FK>>
    * reply_message : TEXT
  }
  entity "notifications" as notifications {
    * is_read : boolean
    * created_at : timestamp(6)
    * notification_id : bigint <<PK, identity>>
    * recipient_user_id : bigint <<FK>>
    * type : varchar(30)
    * title : varchar(150)
    * message : TEXT
  }
}

customers ||--o{ addresses : customer_id
users ||--o{ auth_sessions : user_id
carts ||--o{ cart_items : cart_id
products ||--o{ cart_items : product_id
customers ||--o| carts : customer_id
users ||--o| customers : user_id
users ||--o{ notifications : recipient_user_id
customers ||--o{ order_groups : customer_id
addresses ||--o{ order_groups : shipping_address_id
orders ||--o{ order_items : order_id
products ||--o{ order_items : product_id
order_groups ||--o{ orders : order_group_id
sellers ||--o{ orders : seller_id
order_groups ||--o| payments : order_group_id
categories ||--o{ product_categories : category_id
products ||--o{ product_categories : product_id
products ||--o{ product_images : product_id
sellers ||--o{ products : seller_id
reviews ||--o| review_replies : review_id
sellers ||--o{ review_replies : seller_id
customers ||--o{ reviews : customer_id
order_items ||--o| reviews : order_item_id
products ||--o{ reviews : product_id
users |o--o{ seller_applications : reviewed_by
users ||--o{ seller_applications : user_id
sellers ||--o{ seller_bank_accounts : seller_id
users ||--o| sellers : user_id
orders ||--o| shipments : order_id

legend bottom
  * = NOT NULL (including primary keys); unmarked columns are nullable.
  PK = primary key; FK = foreign key; UQ = column-level unique constraint.
  product_categories has composite PK (category_id, product_id).
  Identity = GENERATED BY DEFAULT AS IDENTITY; SQL types are preserved verbatim.
  Enum values are stored as varchar with CHECK constraints in the SQL source.
  All 20 JPA entity tables plus the Product.categories join table are included.
  Sources: backend/db/supabase-schema.sql and backend/src/main/java/project/project/Entity/**.
  Schema definition, not introspection of a running database.
endlegend
@enduml
